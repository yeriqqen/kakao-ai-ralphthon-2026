# Server-only configuration. Never paste keys into chat or frontend files.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_REVIEW_MODEL=gpt-4.1
OPENAI_REALTIME_MODEL=gpt-realtime
PORT=4173
# Use 0.0.0.0 only when explicitly enabling trusted local-network access.
HOST=127.0.0.1
# Optional existing trusted HTTPS certificate and key paths:
TLS_CERT_FILE=
TLS_KEY_FILE=
# URL reachable by both phones; must use trusted HTTPS for microphone access.
PUBLIC_BASE_URL=
