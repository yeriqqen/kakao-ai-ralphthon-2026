# Copy to .env. Never commit real keys. In-app connection keeps the key in server memory only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_CALL_MODEL=gpt-live-1
PORT=4173

# Optional: OpenAI outbound SIP access + a compatible TLS/Opus/SRTP trunk required.
ENABLE_OUTBOUND_CALLS=false
SIP_PROVIDER_URL=
SIP_USERNAME=
SIP_PASSWORD=
SIP_CALLER_NUMBER=
